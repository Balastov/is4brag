# Confluence Personal Access Token (Data Center 8.5+)
# Получить: Confluence → Manage Account → Personal Access Tokens
CONFLUENCE_PAT=ваш_токен_здесь
CONFLUENCE_URL=https://conf-metro.ibs.ru
CONFLUENCE_TIMEOUT=30

# Runtime paths (host default may be overridden by --base)
KISU_METRO_BASE=/path/to/KISU Metro
IS4BRAG_SANDBOX_PATH=/mnt/write/KISU Metro

# Versioned ingestion settings
IS4BRAG_MODEL_NAME=intfloat/multilingual-e5-large
# Immutable logical version used by cache, queue, payloads and collection names.
# Change it for every model/revision/export whose vectors may differ.
IS4BRAG_MODEL_VERSION=intfloat/multilingual-e5-large
IS4BRAG_EMBEDDING_PROVIDER=pytorch
IS4BRAG_EMBEDDING_DIMENSIONS=1024
IS4BRAG_EMBEDDING_BATCH_SIZE=32
IS4BRAG_EMBEDDING_DEVICE=cpu
# ONNX uses local exported artifacts only; model.onnx may be FP32 or INT8.
IS4BRAG_ONNX_MODEL_PATH=/path/to/export/model.onnx
IS4BRAG_ONNX_TOKENIZER_PATH=/path/to/export
IS4BRAG_ONNX_INTRA_OP_THREADS=4
IS4BRAG_ONNX_QUANTIZATION=int8
IS4BRAG_CHUNK_SIZE=800
IS4BRAG_CHUNK_OVERLAP=150
IS4BRAG_MIN_CHUNK_LEN=100
IS4BRAG_CHUNKER_VERSION=4
# auto/content-aware preserve structural boundaries; legacy keeps line chunking.
IS4BRAG_CHUNK_STRATEGY=auto
IS4BRAG_SCHEMA_VERSION=2

# Canonical SQLite + derived Qdrant index
IS4BRAG_CANONICAL_STORE=1
IS4BRAG_SQLITE_PATH=is4brag.sqlite3
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=
QDRANT_COLLECTION=kisu_metro
QDRANT_ALIAS=kisu_metro_active

# Long-running hybrid search API. Keep bind localhost unless a trusted proxy is used.
SEARCH_API_BIND=127.0.0.1
SEARCH_API_PORT=8080
# Clients (including the KISU skill) prefer this URL when set.
SEARCH_API_URL=http://127.0.0.1:8080
SEARCH_API_TIMEOUT=15
SEARCH_API_CONCURRENCY=4
SEARCH_CANDIDATE_LIMIT=30
SEARCH_SEMANTIC_WEIGHT=0.6
SEARCH_LEXICAL_WEIGHT=0.4
# Required only for /admin/reload; do not log or expose it in health responses.
SEARCH_ADMIN_TOKEN=replace-with-a-long-random-token
# Opt in only if serving potentially stale standalone indexes is acceptable.
SEARCH_API_LEGACY_FALLBACK=0

# Confluence webhook: the HTTP endpoint only validates and enqueues.
# Keep this distinct from PAT/admin secrets. Configure the same secret in Confluence.
CONFLUENCE_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
CONFLUENCE_WEBHOOK_MAX_BYTES=262144
# Optional comma-separated networks. Use only when the direct peer IP is reliable.
CONFLUENCE_WEBHOOK_ALLOWED_CIDRS=
IS4BRAG_INGEST_LEASE_SECONDS=300
IS4BRAG_INGEST_MAX_ATTEMPTS=5
IS4BRAG_INGEST_BASE_BACKOFF=5
